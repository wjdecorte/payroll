# Copy to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=DCI Payroll
APP_VERSION=1.2.0
DEBUG_MODE=false

# ---------------------------------------------------------------------------
# Database
# PostgreSQL (the only supported database):
DATABASE_URL=postgresql://payroll:payroll@localhost:5432/payroll
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Secrets & sessions
# ENCRYPTION_KEY (required): base64 of 32 random bytes, used for AES-256-GCM. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing or changing it makes stored encrypted secrets unreadable.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=dci_session
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
TOTP_ISSUER=DCI Books

# ---------------------------------------------------------------------------
# Logging — "standard" for human-readable, "json" for structured/prod
# ---------------------------------------------------------------------------
API_LOG_TYPE=standard

# ---------------------------------------------------------------------------
# Production server
# ---------------------------------------------------------------------------
WORKERS=2

# ---------------------------------------------------------------------------
# QuickBooks Account Names
# Update these to match your exact chart of accounts in QBO.
# ---------------------------------------------------------------------------
ACCT_OFFICER_COMPENSATION=Payroll Expenses:Wages
ACCT_PAYROLL_TAX_EXPENSE=Payroll Expenses:Taxes
ACCT_HEALTH_INSURANCE_EXP=Health Insurance Expense
ACCT_HSA_EXPENSE=HSA Contribution Expense
ACCT_FED_TAX_PAYABLE=Payroll Liabilities:Federal Taxes (941/943/944)
ACCT_GA_TAX_PAYABLE=Payroll Liabilities:GA Income Tax
ACCT_SS_PAYABLE_EE=Payroll Liabilities:Federal Taxes (941/943/944)
ACCT_SS_PAYABLE_ER=Payroll Liabilities:Federal Taxes (941/943/944)
ACCT_MEDICARE_PAYABLE_EE=Payroll Liabilities:Federal Taxes (941/943/944)
ACCT_MEDICARE_PAYABLE_ER=Payroll Liabilities:Federal Taxes (941/943/944)
ACCT_HEALTH_INS_PAYABLE=Payroll Liabilities:S-Corp Health Insurance
ACCT_HSA_PAYABLE=Payroll Liabilities:Co. HSA
ACCT_CHECKING=Business Checking
